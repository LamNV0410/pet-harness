{
  "name": "furwatch-harness",
  "private": true,
  "description": "Furwatch Harness - local-first hybrid AI development team (monorepo root)",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
